# =========================================================================
# CricPulse-Engine Environment Variables
# =========================================================================

# Server environment (development / production / staging)
ENVIRONMENT=development

# Server port
PORT=8000

# Path to the processed DuckDB OLAP database
DUCKDB_PATH=data/processed/ipl.duckdb

# Sliding-Window Rate Limiting (requests per IP per window)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
